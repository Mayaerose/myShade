<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | myShade</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Mrs+Saint+Delafield&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/normalize.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="topbar">
    <a class="brand-link" href="/">myShade</a>
    <nav>
      <% if (user) { %>
        <% if (user.role === 'admin') { %>
          <a href="/admin">Admin</a>
          <a href="/admin/foundations">Shades</a>
          <a href="/admin/brands">Brands</a>
        <% } %>
        <form action="/logout" method="POST"><button class="link-btn" type="submit">Log out</button></form>
      <% } else { %>
        <a href="/login">Log in</a>
        <a href="/signup">Sign up</a>
      <% } %>
    </nav>
  </header>
  <main class="wrap<%= typeof wide !== 'undefined' && wide ? ' wrap-wide' : '' %>">
    <% if (info && info.length) { %><p class="notice"><%= info %></p><% } %>
    <% if (problem && problem.length) { %><p class="error"><%= problem %></p><% } %>
